<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        The main Podium app target does NOT require App Groups on the free path.
        The widget fetches data directly from localhost:4820, so no shared
        UserDefaults container is needed between the app and the widget.

        The app currently runs unsandboxed (via run.sh / swift build), which is
        the normal mode for a personal-team macOS app. If you later enable the
        App Sandbox for distribution, add com.apple.security.app-sandbox = true
        and any additional entitlements (network.client, file-read-user-selected,
        etc.) that the app needs.
    -->
</dict>
</plist>
