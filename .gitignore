*.swp
.DS_Store

# scripts/package-macos.sh + scripts/build-linux.sh output.
/dist/
/dist-linux/
# Swift-era SwiftPM build dir — tooling still occasionally recreates it.
/.build/
tauri/src-tauri/target*/

# React client (N1 monorepo import) — source is tracked, build output isn't.
client/node_modules/
client/dist/
client/tsconfig.tsbuildinfo

# Node server (N2 vendor import) — source + lockfile tracked, deps aren't.
server/node_modules/
# bun's incremental build cache (dropped alongside server/ by `bun build
# --compile`, ROADMAP N5 TASK A) — not a build artifact anyone consumes.
server/*.bun-build
# same bun build-cache droppings, but from hook/'s own `bun run build`
# (hook/package.json) and from tauri/prepare-sidecar.sh compiling hook/
# (HOOK-BUNDLE STAGING).
hook/*.bun-build
hook/.*.bun-build

