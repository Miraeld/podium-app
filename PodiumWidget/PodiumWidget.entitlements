<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Widget extensions are sandboxed XPC processes.
        com.apple.security.network.client lets the widget reach localhost:4820
        (or any network host) to fetch live data from the Podium server.
        This entitlement is available to FREE personal Apple ID teams —
        no paid Apple Developer Program account is required.

        com.apple.security.application-groups has been intentionally removed.
        App Groups require a paid ($99/yr) Apple Developer account to register.
        The widget fetches data directly from localhost:4820 instead.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
