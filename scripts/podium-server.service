[Unit]
Description=Podium standalone server (REST + WebSocket API + web dashboard)
After=network.target

[Service]
Type=simple
# No --no-hooks: podium-server auto-installs the Claude Code hooks into
# ~/.claude/settings.json on every startup (idempotent, non-fatal on
# failure — see PodiumServerCLI.installHooksNonFatal), matching the P6.1
# acceptance bar of "download -> open -> your agents appear live" with no
# separate install step for this unit to run.
#
# No --web-dist / $PODIUM_WEB_DIST needed either: install-linux.sh copies
# the vendored dashboard to /usr/local/share/podium/web, which
# WebDistResolver.resolve() (Sources/PodiumServer/Static/StaticFileHandler.swift)
# checks by default as the "installed Linux layout" fallback.
# podium-server now defaults to binding 127.0.0.1 only (loopback), matching
# the desktop app's Tauri shell which only ever talks to localhost. This
# headless unit exists to serve the dashboard to a browser on another
# machine (the "what runs headless on a Linux server" use case from
# README.md), so we explicitly opt back in to a LAN-reachable bind here.
# The run-spawning endpoints (POST /api/run) have no authentication —
# only run this on a trusted network, and put it behind a reverse proxy /
# VPN if it needs to be reachable from anywhere less trusted.
Environment=PODIUM_HOST=0.0.0.0
ExecStart=/usr/local/bin/podium-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
