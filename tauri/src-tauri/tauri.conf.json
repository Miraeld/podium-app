{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Podium",
  "version": "0.5.3",
  "identifier": "com.gaelrobin.PodiumApp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Podium",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Real-time observer for Claude Code agent sessions",
    "longDescription": "Podium watches your Claude Code agent sessions in real time, backed by a local SQLite database and a bundled podium-server sidecar. No cloud, no browser tab — a native window on macOS and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/podium-server"],
    "resources": ["web-dist/"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
