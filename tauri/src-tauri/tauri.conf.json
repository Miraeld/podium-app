{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Podium",
  "version": "1.0.2",
  "identifier": "com.gaelrobin.PodiumApp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Real-time observer for Claude Code agent sessions",
    "longDescription": "Podium watches your Claude Code agent sessions in real time, backed by a local SQLite database and a bundled podium-server sidecar. No cloud, no browser tab — a native window on macOS and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/podium-server",
      "bin/podium-hook"
    ],
    "resources": [
      "web-dist/"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQUZBRjkyRDVGM0EyNUEKUldSYW92UFZrcSt2MEJWNU05MXBMZ2h5NDR2S0Y1dDhvRVQyRVpEbHQ4NWVJZlhvTFRlVzdUckoK",
      "endpoints": [
        "https://github.com/Miraeld/podium-app/releases/latest/download/latest.json"
      ]
    }
  }
}
