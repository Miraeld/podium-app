# Rust build output
/src-tauri/target/

# Node (Tauri CLI via npm, if used instead of the global cargo-tauri binary)
/node_modules/
package-lock.json

# Sidecar binary — bun-compiled from ../server/ by prepare-sidecar.sh
# (ROADMAP N5 TASK A; was a Swift build pre-pivot). Not source, and it's a
# ~61MB platform-specific artifact — never commit it.
/src-tauri/bin/

# Staged client/dist copy (bundled as a Tauri resource so podium-server can
# find it via --web-dist inside the .app — see prepare-sidecar.sh). Derived
# from client/dist (was WebClient/dist pre-N1); never commit a second copy.
/src-tauri/web-dist/

# Generated icon set (from `cargo tauri icon icon-source.png`) — regenerate
# on demand rather than tracking derived PNGs/ICNS/ICO. icon-source.png
# itself IS tracked (see below) — it's the one real source asset, not a
# derived artifact; every fresh clone/worktree needs it to run
# `cargo tauri icon` and previously had no way to get it.
/src-tauri/icons/

# Tauri build metadata
/src-tauri/gen/
